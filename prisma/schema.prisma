  meal_logs   MealLog  @relation(fields: [meal_log_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_meal_log_recipes_meal_log")
  recipes     Recipe   @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_meal_log_recipes_recipe")

  @@unique([meal_log_id, recipe_id], map: "uq_meal_log_recipe_unique")
  @@index([meal_log_id], map: "idx_meal_log_recipes_meal_log")
  @@index([recipe_id], map: "idx_meal_log_recipes_recipe")
}
