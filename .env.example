# Environment variables for Namly Backend

# Application
APP_NAME=Namly API
NODE_ENV=development
PORT=3000

# API
API_PREFIX=api/v1
CORS_ORIGIN=*

# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional: Transaction pooler (port 6543) — do not use with Prisma $transaction
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiI..."
SUPABASE_JWT_SECRET="your-super-secret-jwt-key-for-rls"
SUPABASE_SERVICE_ROLE_KEY="role-key-..."

# Other (e.g., storage, external services)
# STORAGE_BUCKET_URL=https://xyz.supabase.co/storage/v1/object/public/
